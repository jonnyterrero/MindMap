# MindMap ML layer — environment template. Copy to `.env` and fill in.
# NEVER commit a real .env. The ML batch job reads these at runtime only.

# Supabase (Phase 5 serving). Service-role key is server-only — never ship to the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Phase 6 narrative). Matches the app's claude-opus-4-8 reflection voice.
ANTHROPIC_API_KEY=

# Journal decrypt endpoint (ADR-002). When BOTH are set, the graph batch pulls
# decrypted journal plaintext from this Vercel route instead of reading the
# table directly, so it covers encrypted entries WITHOUT ever holding the
# master key. The secret is NOT the master key — it only authorizes live calls
# and is instantly rotatable. Leave blank locally to use the direct-read
# fallback (plaintext rows only; encrypted entries skipped).
ML_JOURNAL_DECRYPT_URL=
ML_JOURNAL_DECRYPT_SECRET=
# Incremental pull window in days (default 7). --all ignores it for backfill.
ML_JOURNAL_LOOKBACK_DAYS=7
