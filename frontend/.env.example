# MindMap — copy to .env.local (never commit real values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic — AI chat, journal reflection, report generation, voice sentiment.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Bearer token for the scheduled report job. /api/cron/generate-reports
# rejects any request without a matching token, and stays inert while this
# is unset, so it must match the value configured on the Vercel cron trigger.
CRON_SECRET=your_cron_secret
